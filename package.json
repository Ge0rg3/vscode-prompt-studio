{
  "name": "prompt-studio",
  "displayName": "Prompt Studio",
  "description": "Obsidian-like vault of markdown notes and reusable prompts inside VSCode.",
  "version": "0.0.1",
  "publisher": "prompt-studio-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ge0rg3/vscode-prompt-studio.git"
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:promptStudio.visual",
    "onWebviewPanel:promptStudio.template"
  ],
  "contributes": {
    "configuration": {
      "title": "Prompt Studio",
      "properties": {
        "promptStudio.vaultPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the vault folder. Leave empty to use a per-workspace vault stored under the extension's global storage. Run **Prompt Studio: Configure Vault** for a guided picker."
        }
      }
    },
    "commands": [
      {
        "command": "promptStudio.configureVault",
        "title": "Configure Vault",
        "category": "Prompt Studio",
        "icon": "$(gear)"
      },
      {
        "command": "promptStudio.openVisual",
        "title": "Open Visual Canvas",
        "category": "Prompt Studio",
        "icon": "$(layout)"
      },
      {
        "command": "promptStudio.newNote",
        "title": "New Note",
        "category": "Prompt Studio",
        "icon": "$(new-file)"
      },
      {
        "command": "promptStudio.newFolder",
        "title": "New Folder",
        "category": "Prompt Studio",
        "icon": "$(new-folder)"
      },
      {
        "command": "promptStudio.expandAll",
        "title": "Expand All",
        "category": "Prompt Studio",
        "icon": "$(expand-all)"
      },
      {
        "command": "promptStudio.collapseAll",
        "title": "Collapse All",
        "category": "Prompt Studio",
        "icon": "$(collapse-all)"
      },
      {
        "command": "promptStudio.rename",
        "title": "Rename",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.copyContents",
        "title": "Copy Contents",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.openTemplate",
        "title": "Open as Template",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.sendToClaude",
        "title": "Send to Claude",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.copyPathStatic",
        "title": "Copy as Path (Static)",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.copyPathRelative",
        "title": "Copy as Path (Relative)",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.revealInOS",
        "title": "Reveal in Explorer",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.delete",
        "title": "Delete",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.refreshSkills",
        "title": "Refresh Skills",
        "category": "Prompt Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "promptStudio.openSkill",
        "title": "Open SKILL.md",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.openSkillTemplate",
        "title": "Open as Template",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.openSkillVisual",
        "title": "Open as Canvas",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.sendSkillToClaude",
        "title": "Send to Claude",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.newSkill",
        "title": "New Skill",
        "category": "Prompt Studio",
        "icon": "$(add)"
      },
      {
        "command": "promptStudio.openSkillsCanvas",
        "title": "Open Visual Canvas",
        "category": "Prompt Studio",
        "icon": "$(layout)"
      },
      {
        "command": "promptStudio.expandAllSkills",
        "title": "Expand All",
        "category": "Prompt Studio",
        "icon": "$(expand-all)"
      },
      {
        "command": "promptStudio.collapseAllSkills",
        "title": "Collapse All",
        "category": "Prompt Studio",
        "icon": "$(collapse-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptStudio",
          "title": "Prompt Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "promptStudio": [
        {
          "id": "promptStudio.vault",
          "name": "Vault",
          "type": "webview"
        },
        {
          "id": "promptStudio.skills",
          "name": "Claude Skills",
          "type": "webview",
          "when": "promptStudio.hasSkills"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "promptStudio.newNote",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@1"
        },
        {
          "command": "promptStudio.newFolder",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@2"
        },
        {
          "command": "promptStudio.openVisual",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@3"
        },
        {
          "command": "promptStudio.expandAll",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@4"
        },
        {
          "command": "promptStudio.collapseAll",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@5"
        },
        {
          "command": "promptStudio.configureVault",
          "when": "view == promptStudio.vault",
          "group": "navigation@99"
        },
        {
          "command": "promptStudio.newSkill",
          "when": "view == promptStudio.skills",
          "group": "navigation@1"
        },
        {
          "command": "promptStudio.openSkillsCanvas",
          "when": "view == promptStudio.skills",
          "group": "navigation@2"
        },
        {
          "command": "promptStudio.expandAllSkills",
          "when": "view == promptStudio.skills",
          "group": "navigation@3"
        },
        {
          "command": "promptStudio.collapseAllSkills",
          "when": "view == promptStudio.skills",
          "group": "navigation@4"
        },
        {
          "command": "promptStudio.refreshSkills",
          "when": "view == promptStudio.skills",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "promptStudio.openVisual",
          "when": "promptStudio.hasVault"
        },
        {
          "command": "promptStudio.newNote",
          "when": "promptStudio.hasVault"
        },
        {
          "command": "promptStudio.newFolder",
          "when": "promptStudio.hasVault"
        },
        {
          "command": "promptStudio.expandAll",
          "when": "false"
        },
        {
          "command": "promptStudio.collapseAll",
          "when": "false"
        },
        {
          "command": "promptStudio.rename",
          "when": "false"
        },
        {
          "command": "promptStudio.copyContents",
          "when": "false"
        },
        {
          "command": "promptStudio.openTemplate",
          "when": "false"
        },
        {
          "command": "promptStudio.sendToClaude",
          "when": "false"
        },
        {
          "command": "promptStudio.copyPathStatic",
          "when": "false"
        },
        {
          "command": "promptStudio.copyPathRelative",
          "when": "false"
        },
        {
          "command": "promptStudio.revealInOS",
          "when": "false"
        },
        {
          "command": "promptStudio.delete",
          "when": "false"
        },
        {
          "command": "promptStudio.refreshSkills",
          "when": "promptStudio.hasSkills"
        },
        {
          "command": "promptStudio.openSkill",
          "when": "false"
        },
        {
          "command": "promptStudio.openSkillTemplate",
          "when": "false"
        },
        {
          "command": "promptStudio.openSkillVisual",
          "when": "false"
        },
        {
          "command": "promptStudio.sendSkillToClaude",
          "when": "false"
        },
        {
          "command": "promptStudio.openSkillsCanvas",
          "when": "promptStudio.hasSkills"
        },
        {
          "command": "promptStudio.expandAllSkills",
          "when": "false"
        },
        {
          "command": "promptStudio.collapseAllSkills",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "yaml": "^2.9.0"
  }
}
