{
  "name": "prompt-studio",
  "displayName": "Prompt Studio",
  "description": "Obsidian-like vault of markdown notes and reusable prompts inside VSCode.",
  "version": "0.2.1",
  "publisher": "Ge0rg3",
  "license": "GPL-3.0-only",
  "icon": "media/marketplaceIcon.png",
  "galleryBanner": {
    "color": "#1c2333",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "markdown",
    "notes",
    "vault",
    "prompts",
    "canvas"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ge0rg3/vscode-prompt-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Ge0rg3/vscode-prompt-studio/issues"
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:promptStudio.visual",
    "onWebviewPanel:promptStudio.template",
    "onWebviewPanel:promptStudio.settings"
  ],
  "contributes": {
    "commands": [
      {
        "command": "promptStudio.openSettings",
        "title": "Settings",
        "category": "Prompt Studio",
        "icon": "$(gear)"
      },
      {
        "command": "promptStudio.openVisual",
        "title": "Open Visual Canvas",
        "category": "Prompt Studio",
        "icon": "$(layout)"
      },
      {
        "command": "promptStudio.newNote",
        "title": "New Note",
        "category": "Prompt Studio",
        "icon": "$(new-file)"
      },
      {
        "command": "promptStudio.newFolder",
        "title": "New Folder",
        "category": "Prompt Studio",
        "icon": "$(new-folder)"
      },
      {
        "command": "promptStudio.expandAll",
        "title": "Expand All",
        "category": "Prompt Studio",
        "icon": "$(expand-all)"
      },
      {
        "command": "promptStudio.collapseAll",
        "title": "Collapse All",
        "category": "Prompt Studio",
        "icon": "$(collapse-all)"
      },
      {
        "command": "promptStudio.rename",
        "title": "Rename",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.copyContents",
        "title": "Copy Contents",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.openTemplate",
        "title": "Open as Template",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.sendToClaude",
        "title": "Send to Claude",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.copyPathStatic",
        "title": "Copy as Path (Static)",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.copyPathRelative",
        "title": "Copy as Path (Relative)",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.revealInOS",
        "title": "Reveal in File Manager",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.delete",
        "title": "Delete",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.refreshSkills",
        "title": "Refresh Skills",
        "category": "Prompt Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "promptStudio.openSkill",
        "title": "Open SKILL.md",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.openSkillTemplate",
        "title": "Open as Template",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.openSkillVisual",
        "title": "Open as Canvas",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.sendSkillToClaude",
        "title": "Send to Claude",
        "category": "Prompt Studio"
      },
      {
        "command": "promptStudio.newSkill",
        "title": "New Skill",
        "category": "Prompt Studio",
        "icon": "$(add)"
      },
      {
        "command": "promptStudio.openSkillsCanvas",
        "title": "Open Visual Canvas",
        "category": "Prompt Studio",
        "icon": "$(layout)"
      },
      {
        "command": "promptStudio.expandAllSkills",
        "title": "Expand All",
        "category": "Prompt Studio",
        "icon": "$(expand-all)"
      },
      {
        "command": "promptStudio.collapseAllSkills",
        "title": "Collapse All",
        "category": "Prompt Studio",
        "icon": "$(collapse-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptStudio",
          "title": "Prompt Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "promptStudio": [
        {
          "id": "promptStudio.vault",
          "name": "Vault",
          "type": "webview"
        },
        {
          "id": "promptStudio.skills",
          "name": "Claude Skills",
          "type": "webview",
          "when": "promptStudio.hasSkills"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "promptStudio.newNote",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@1"
        },
        {
          "command": "promptStudio.newFolder",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@2"
        },
        {
          "command": "promptStudio.openVisual",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@3"
        },
        {
          "command": "promptStudio.expandAll",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@4"
        },
        {
          "command": "promptStudio.collapseAll",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@5"
        },
        {
          "command": "promptStudio.openSettings",
          "when": "view == promptStudio.vault",
          "group": "navigation@99"
        },
        {
          "command": "promptStudio.newSkill",
          "when": "view == promptStudio.skills",
          "group": "navigation@1"
        },
        {
          "command": "promptStudio.openSkillsCanvas",
          "when": "view == promptStudio.skills",
          "group": "navigation@2"
        },
        {
          "command": "promptStudio.expandAllSkills",
          "when": "view == promptStudio.skills",
          "group": "navigation@3"
        },
        {
          "command": "promptStudio.collapseAllSkills",
          "when": "view == promptStudio.skills",
          "group": "navigation@4"
        },
        {
          "command": "promptStudio.refreshSkills",
          "when": "view == promptStudio.skills",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "promptStudio.openVisual",
          "when": "promptStudio.hasVault"
        },
        {
          "command": "promptStudio.newNote",
          "when": "promptStudio.hasVault"
        },
        {
          "command": "promptStudio.newFolder",
          "when": "promptStudio.hasVault"
        },
        {
          "command": "promptStudio.expandAll",
          "when": "false"
        },
        {
          "command": "promptStudio.collapseAll",
          "when": "false"
        },
        {
          "command": "promptStudio.rename",
          "when": "false"
        },
        {
          "command": "promptStudio.copyContents",
          "when": "false"
        },
        {
          "command": "promptStudio.openTemplate",
          "when": "false"
        },
        {
          "command": "promptStudio.sendToClaude",
          "when": "false"
        },
        {
          "command": "promptStudio.copyPathStatic",
          "when": "false"
        },
        {
          "command": "promptStudio.copyPathRelative",
          "when": "false"
        },
        {
          "command": "promptStudio.revealInOS",
          "when": "false"
        },
        {
          "command": "promptStudio.delete",
          "when": "false"
        },
        {
          "command": "promptStudio.refreshSkills",
          "when": "promptStudio.hasSkills"
        },
        {
          "command": "promptStudio.openSkill",
          "when": "false"
        },
        {
          "command": "promptStudio.openSkillTemplate",
          "when": "false"
        },
        {
          "command": "promptStudio.openSkillVisual",
          "when": "false"
        },
        {
          "command": "promptStudio.sendSkillToClaude",
          "when": "false"
        },
        {
          "command": "promptStudio.openSkillsCanvas",
          "when": "promptStudio.hasSkills"
        },
        {
          "command": "promptStudio.expandAllSkills",
          "when": "false"
        },
        {
          "command": "promptStudio.collapseAllSkills",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Prompt Studio",
      "properties": {
        "promptStudio.defaultNoteView": {
          "type": "string",
          "enum": [
            "template",
            "file"
          ],
          "enumDescriptions": [
            "Open the note in the template editor.",
            "Open the note's markdown in a text editor."
          ],
          "default": "template",
          "description": "Which view a note opens in when you click it in the Vault view or on the canvas. The other view stays on the row's hover button and in the right-click menu."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
