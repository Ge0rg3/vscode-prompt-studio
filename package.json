{
  "name": "prompt-studio",
  "displayName": "Prompt Studio",
  "description": "Obsidian-like vault of markdown notes and reusable prompts inside VSCode.",
  "version": "0.0.1",
  "publisher": "prompt-studio-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ge0rg3/vscode-prompt-studio.git"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Prompt Studio",
      "properties": {
        "promptStudio.vaultPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the vault folder. Leave empty to use a per-workspace vault stored under the extension's global storage. Run **Prompt Studio: Configure Vault** for a guided picker."
        }
      }
    },
    "commands": [
      {
        "command": "promptStudio.configureVault",
        "title": "Configure Vault",
        "category": "Prompt Studio",
        "icon": "$(gear)"
      },
      {
        "command": "promptStudio.newNote",
        "title": "New Note",
        "category": "Prompt Studio",
        "icon": "$(new-file)"
      },
      {
        "command": "promptStudio.newFolder",
        "title": "New Folder",
        "category": "Prompt Studio",
        "icon": "$(new-folder)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptStudio",
          "title": "Prompt Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "promptStudio": [
        {
          "id": "promptStudio.vault",
          "name": "Vault"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "promptStudio.vault",
        "contents": "No vault is configured.\n[Configure Vault](command:promptStudio.configureVault)",
        "when": "!promptStudio.hasVault"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "promptStudio.newNote",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@1"
        },
        {
          "command": "promptStudio.newFolder",
          "when": "view == promptStudio.vault && promptStudio.hasVault",
          "group": "navigation@2"
        },
        {
          "command": "promptStudio.configureVault",
          "when": "view == promptStudio.vault",
          "group": "navigation@99"
        }
      ],
      "view/item/context": [
        {
          "command": "promptStudio.newNote",
          "when": "view == promptStudio.vault && viewItem == folder",
          "group": "1_create@1"
        },
        {
          "command": "promptStudio.newFolder",
          "when": "view == promptStudio.vault && viewItem == folder",
          "group": "1_create@2"
        }
      ],
      "commandPalette": [
        {
          "command": "promptStudio.newNote",
          "when": "promptStudio.hasVault"
        },
        {
          "command": "promptStudio.newFolder",
          "when": "promptStudio.hasVault"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
